{
  "framework": "vite",
  "buildCommand": "cd Downtown-Fitness/artifacts/downtown-fitness && pnpm run build",
  "outputDirectory": "Downtown-Fitness/artifacts/downtown-fitness/dist",
  "installCommand": "cd Downtown-Fitness && pnpm install --no-frozen-lockfile",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
